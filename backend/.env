# Sovereign AI Workbench - Environment Configuration
# Copy this file to .env and adjust values for your deployment

# Application
APP_NAME=Sovereign AI Workbench
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, demo, production
DEBUG=false

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sovereign_ai

# Vector Database
VECTOR_DB_URL=http://localhost:6333

# Ollama (Local Model Runtime)
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Authentication - CHANGE IN PRODUCTION
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-64-CHAR-STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Security
AIR_GAPPED_MODE=true
# Origins allowed to call the API directly (cross-origin). Only needed
# if a browser hits the backend on a DIFFERENT origin than it loaded the
# page from - the normal dev proxy (vite.config.ts) and the production
# nginx proxy (frontend/nginx.conf) both serve the frontend and /api on
# the SAME origin, so most LAN deployments never need this changed.
# For LAN access, replace localhost with the SERVER machine's own LAN
# IP, e.g.: CORS_ORIGINS=["http://192.168.1.50:5173","http://192.168.1.50:3000"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage
UPLOAD_DIR=./data/uploads
GENERATED_DIR=./data/generated
MAX_UPLOAD_SIZE_MB=500

# Sandbox
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOWED_LANGUAGES=["python","javascript","bash"]

# Quotas
DEFAULT_MAX_CONCURRENT_JOBS=3
DEFAULT_MAX_STORAGE_MB=5000
DEFAULT_MAX_REQUESTS_PER_HOUR=100

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379/0
